{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": [
        "src/components/*"
      ],
      "@context/*": [
        "src/context/*"
      ],
      "@screens/*": [
        "src/screens/*"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@repositories/*": [
        "src/repositories/*"
      ],
      "@queries/*": [
        "src/queries/*"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@schemas/*": [
        "src/schemas/*"
      ],
      "@navigation/*": [
        "src/navigation/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@models/*": [
        "src/types/*"
      ],
      "@navigators/*": [
        "src/navigators/*"
      ]
    }
  }
}
